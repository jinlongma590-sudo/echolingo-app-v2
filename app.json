{
  "expo": {
    "name": "EchoLingo",
    "slug": "echolingo-app-v2",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "echolingov2",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "buildNumber": "16",
      "bundleIdentifier": "cn.echolingo.appv2",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow EchoLingo V2 to access your photos to change your avatar",
        "NSCameraUsageDescription": "Allow EchoLingo V2 to use your camera to take an avatar photo",
        "NSPhotoLibraryAddUsageDescription": "Allow EchoLingo V2 to save avatar photos to your photo library when needed"
      }
    },
    "android": {
      "package": "cn.echolingo.appv2",
      "versionCode": 6,
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_NETWORK_STATE",
        "CHANGE_NETWORK_STATE",
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F7F8FA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8FA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 260,
          "ios": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#F7F8FA",
            "imageWidth": 260
          },
          "android": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#F7F8FA",
            "imageWidth": 260
          },
          "dark": {
            "backgroundColor": "#0F172A",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 260
          }
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "EchoLingo uses the microphone to record your voice for speaking practice, speech recognition, pronunciation feedback, and AI conversation.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow EchoLingo V2 to access your photos to change your avatar",
          "cameraPermission": "Allow EchoLingo V2 to use your camera to take an avatar photo"
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
